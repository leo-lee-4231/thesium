# Copy to .env and adjust before `docker compose up`.
POSTGRES_USER=thesium
POSTGRES_PASSWORD=thesium
POSTGRES_DB=thesium

# Base images. If Docker Hub is blocked, point these at a mirror, e.g.:
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# NODE_IMAGE=docker.m.daocloud.io/library/node:24-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com

THESIUM_ENVIRONMENT=development
THESIUM_LOG_LEVEL=INFO
# Set a long random value if the API is reachable from anywhere except localhost.
THESIUM_ADMIN_TOKEN=
# OKX may require an HTTP proxy on some networks.
# For local processes: HTTPS_PROXY=http://127.0.0.1:7897
# For Docker: HTTPS_PROXY=http://host.docker.internal:7897

# Copy to .env and adjust before `docker compose up`.
POSTGRES_USER=thesium
POSTGRES_PASSWORD=thesium
POSTGRES_DB=thesium

# Base images. If Docker Hub is blocked, point these at a mirror, e.g.:
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# NODE_IMAGE=docker.m.daocloud.io/library/node:24-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com

THESIUM_ENVIRONMENT=development
THESIUM_LOG_LEVEL=INFO
# Base URL used in notification emails and Run links.
THESIUM_WEB_BASE_URL=http://127.0.0.1:5173
# Optional dedicated proxy for OKX market data. If your HTTP proxy is flaky for OKX,
# try the mixed port with SOCKS remote DNS: socks5h://127.0.0.1:7897
# THESIUM_MARKET_PROXY=socks5h://127.0.0.1:7897
# Worker: set to false to pause automatic monitor scheduling (manual analysis still works).
THESIUM_SCHEDULER_ENABLED=true
THESIUM_WORKER_POLL_SECONDS=15
# Set a long random value if the API is reachable from anywhere except localhost.
THESIUM_ADMIN_TOKEN=
# OKX may require an HTTP proxy on some networks.
# For local processes: HTTPS_PROXY=http://127.0.0.1:7897
# For Docker: HTTPS_PROXY=http://host.docker.internal:7897

# Optional: OpenAI-compatible LLM for Thesis polish/structure.
# Without these, manual editing works but AI buttons return LLM_NOT_CONFIGURED.
THESIUM_LLM_BASE_URL=
THESIUM_LLM_MODEL=
THESIUM_LLM_API_KEY=

# Optional but recommended for Docker: Fernet key used to encrypt the LLM API key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
THESIUM_SECRET_KEY=

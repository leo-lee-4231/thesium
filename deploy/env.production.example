# Copy to project root as .env, then edit. Never commit .env.

# PostgreSQL
POSTGRES_USER=thesium
POSTGRES_DB=thesium
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Required. Generate a Fernet key:
# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
THESIUM_SECRET_KEY=CHANGE_ME

# Tailscale Serve URL (update after `tailscale serve status`), or a temporary
# http://127.0.0.1:8080 for first boot. Used in email links.
THESIUM_WEB_BASE_URL=http://127.0.0.1:8080

# Thesium on the host Clash mixed port (this Aliyun server uses 37890). socks5h keeps DNS on the proxy.
THESIUM_MARKET_PROXY=socks5h://host.docker.internal:37890
HTTP_PROXY=http://host.docker.internal:37890
HTTPS_PROXY=http://host.docker.internal:37890
NO_PROXY=localhost,127.0.0.1,postgres,api,web

THESIUM_ENVIRONMENT=production
THESIUM_LOG_LEVEL=INFO
THESIUM_SCHEDULER_ENABLED=true
THESIUM_WORKER_POLL_SECONDS=15
TZ=Asia/Shanghai

# Market data retention (daily maintenance job at 03:15 UTC).
THESIUM_MARKET_RETENTION_ENABLED=true
THESIUM_MARKET_CANDLE_RETENTION_DAYS_1H=365
THESIUM_MARKET_CANDLE_RETENTION_DAYS_4H=730
THESIUM_MARKET_CANDLE_RETENTION_DAYS_1D=1825
THESIUM_MARKET_SNAPSHOT_RETENTION_DAYS=90

# Optional environment fallback for the LLM; Settings/DB is preferred.
THESIUM_LLM_BASE_URL=
THESIUM_LLM_MODEL=
THESIUM_LLM_API_KEY=

# Optional mirror settings if Docker Hub is slow.
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# NODE_IMAGE=docker.m.daocloud.io/library/node:24-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com

ARG PYTHON_IMAGE=python:3.12-slim

# Dependency base stage.
#
# Keep this stage independent of backend/app: changing application code must not
# invalidate the pip install layer. Only pyproject.toml changes should rebuild it.
FROM ${PYTHON_IMAGE} AS base

ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY backend/pyproject.toml ./pyproject.toml

# A stub package is enough to resolve and install all runtime dependencies.
# The real app is copied into the runtime stage below and shadows this stub.
RUN mkdir -p app && touch app/__init__.py \
    && pip install --no-cache-dir . \
    && pip uninstall -y thesium

FROM base AS runtime

WORKDIR /app

COPY backend/app ./app
COPY backend/alembic.ini ./alembic.ini
COPY backend/alembic ./alembic

COPY deploy/entrypoint.api.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
